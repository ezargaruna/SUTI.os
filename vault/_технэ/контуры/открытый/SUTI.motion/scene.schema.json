{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:suti:motion:scene:0.2",
  "title": "SUTI.motion scene document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "language",
    "purpose",
    "canvas",
    "duration_ms",
    "loop",
    "style",
    "scenes"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7680
        }
      }
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 300000
    },
    "loop": {
      "type": "boolean"
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "foreground",
        "accent",
        "font_family"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "foreground": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "font_family": {
          "enum": [
            "system-ui",
            "serif",
            "monospace"
          ]
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "start_ms",
          "duration_ms",
          "label",
          "headline",
          "support",
          "motion"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 1000
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "support": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "motion": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "duration_ms"
            ],
            "properties": {
              "type": {
                "enum": [
                  "none",
                  "fade",
                  "rise"
                ]
              },
              "duration_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Semantic checks: unique scene ids; scenes sorted and contiguous from 0; total equals duration_ms; transition <= half scene duration. Run export.py for the supported renderer."
}
